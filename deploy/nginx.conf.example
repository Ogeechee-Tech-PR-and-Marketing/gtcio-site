# Reverse proxy + TLS termination for the self-hosted GTCIO site.
# Copy to /etc/nginx/sites-available/gtcio-site, set the real hostname below,
# symlink into sites-enabled, then run certbot (see the migration runbook).
#
# Next.js (via `npm start`, started by gtcio-site.service) listens only on
# 127.0.0.1:3000 — nginx is the only thing exposed to the internet.

server {
    listen 80;
    listen [::]:80;
    server_name gtcio.ogeecheetech.edu;  # <-- set to whatever hostname OTC IT assigns

    # Let's Encrypt HTTP-01 challenge — certbot writes into this path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gtcio.ogeecheetech.edu;  # <-- match the block above

    ssl_certificate     /etc/letsencrypt/live/gtcio.ogeecheetech.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gtcio.ogeecheetech.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Every other security header (CSP, X-Frame-Options, Permissions-Policy,
    # HSTS as of this migration) is set by the app itself in next.config.ts —
    # deliberately not duplicated here, so there's one place to check.

    client_max_body_size 1m;  # /api/inquiry and /api/newsletter already cap payloads themselves

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
