[Unit]
Description=GTCIO website (Next.js)
After=network.target

[Service]
Type=simple
User=gtcio
Group=gtcio
WorkingDirectory=/opt/gtcio-site/app
EnvironmentFile=/opt/gtcio-site/shared/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Light sandboxing — the app only needs to read its own directory and env
# file and bind to a loopback port; nginx handles the public-facing side.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
