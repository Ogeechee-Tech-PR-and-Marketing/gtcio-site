# Copy to .env.local and fill in. Every variable the code reads is listed here.
# Full context: PROJECT.md §6 (what each does) and §11 (Constant Contact).
# In production these live in Vercel → gtcio-site → Settings → Environment
# Variables; a redeploy is required after changing any of them.

# ---- Site-wide PIN gate (optional) ------------------------------------------
# Set this to require a shared access code before ANY page loads — a basic
# "coming soon" screen door to keep casual visitors out pre-launch, not real
# auth. Unset = the gate is off and the site is fully public (src/middleware.ts
# fails open). Whoever enters this exact string gets a 30-day cookie. See
# PROJECT.md §6.
SITE_ACCESS_PIN=

# ---- Sanity (public — safe in the browser bundle, not secrets) --------------
# Project kjz4q8d4 / dataset production. The dataset is publicly readable,
# which is why no token is needed to render published content.
NEXT_PUBLIC_SANITY_PROJECT_ID=kjz4q8d4
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# ---- Sanity tokens (secret, server-only) ------------------------------------
# Create at https://sanity.io/manage → project kjz4q8d4 → API → Tokens.
# Tokens are shown ONCE at creation — store them in a password manager.
# You must be a member of the Sanity project to do this; ask the project
# admin (see PROJECT.md §12) for an invite.
#
# Viewer-role token. Used server-side only, for draft/preview reads
# (Studio "Edit on page"). Without it: the live site still works, but
# draft preview silently fails.
SANITY_API_READ_TOKEN=
# Editor-role token. Used ONLY by /api/inquiry and the Constant Contact
# token store, via the server-only writeClient. Without it: form
# submissions are lost (not saved, no email) and the newsletter breaks.
SANITY_API_WRITE_TOKEN=

# ---- Microsoft Graph mail (secret) ------------------------------------------
# Sends the /api/inquiry notification emails via an Azure AD app registration's
# client-credentials grant — see PROJECT.md §5/§11 for the one-time Azure setup
# an OTC Microsoft 365 tenant admin has to run. Recipients (Jan Moore / Sean
# Payne) are fixed constants in src/app/api/inquiry/route.ts, not env vars —
# one shared credential here can send to either address.
# Unset = submissions are still saved to the Studio inbox, but nobody gets
# emailed and the doc is flagged "NOT EMAILED".
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox the notification emails are sent AS (e.g. a shared mailbox like
# gtcio-website@ogeecheetech.edu). Must be a real mailbox in the tenant, and
# the app registration should be scoped (via an Exchange application access
# policy) to send only as this one mailbox.
MS_GRAPH_SENDER_EMAIL=

# ---- Constant Contact newsletter (secret) -----------------------------------
# From the "Custom App" at developer.constantcontact.com (see PROJECT.md §11
# for the full one-time setup). Unset = the footer newsletter form fails
# gracefully with "Something went wrong"; nothing crashes.
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
# Any random string you pick (e.g. `openssl rand -hex 16`). Gates the
# one-time OAuth setup URL /api/constant-contact/oauth/start — the only
# thing standing between the public internet and that route.
CONSTANT_CONTACT_SETUP_SECRET=
