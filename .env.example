# Copy to .env.local and fill in. Every variable the code reads is listed here.
# Full context: PROJECT.md §6 (what each does) and §8 (Constant Contact).
# In production these live in Vercel → gtcio-site → Settings → Environment
# Variables; a redeploy is required after changing any of them.

# ---- Site-wide PIN gate (optional) ------------------------------------------
# Set this to require a shared access code before ANY page loads — a basic
# "coming soon" screen door to keep casual visitors out pre-launch, not real
# auth. Unset = the gate is off and the site is fully public (src/middleware.ts
# fails open). Whoever enters this exact string gets a 30-day cookie. See
# PROJECT.md §6.
SITE_ACCESS_PIN=

# ---- Form notification email ------------------------------------------------
# src/lib/mail.ts uses the FIRST configured provider below. Unset both = form
# submissions are parked in the KV store (src/lib/inquiryStore.ts) and read
# with `npm run inquiries`; the visitor still sees a success message.
# Recipients (Jan Moore / Sean Payne) are fixed constants in
# src/app/api/inquiry/route.ts, not env vars.

# 1) Resend (secret) — installed from the Vercel Marketplace, which injects
# this automatically. gtcio.org must be verified in Resend (DNS at GoDaddy)
# before mail is delivered. See PROJECT.md §5.
RESEND_API_KEY=
# Optional sender override. Must be on the verified domain.
# Default: "GTCIO Website <website@gtcio.org>"
MAIL_FROM=

# 2) Microsoft Graph (secret) — the institutional route: an Azure AD app
# registration's client-credentials grant, sending AS an OTC mailbox. Needs
# an OTC Microsoft 365 tenant admin (PROJECT.md §5). Only used when Resend
# is not configured.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox the notification emails are sent AS (e.g. a shared mailbox like
# gtcio-website@ogeecheetech.edu). Must be a real mailbox in the tenant, and
# the app registration should be scoped (via an Exchange application access
# policy) to send only as this one mailbox.
MS_GRAPH_SENDER_EMAIL=

# ---- Constant Contact newsletter (secret) -----------------------------------
# From the "Custom App" at developer.constantcontact.com (see PROJECT.md §8
# for the full one-time setup). Unset = the footer newsletter form fails
# gracefully with "Something went wrong"; nothing crashes.
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
# Any random string you pick (e.g. `openssl rand -hex 16`). Gates the
# one-time OAuth setup URL /api/constant-contact/oauth/start — the only
# thing standing between the public internet and that route.
CONSTANT_CONTACT_SETUP_SECRET=

# ---- Vercel KV (Constant Contact OAuth token store) -------------------------
# Provisioned via Vercel → gtcio-site → Storage → Create Database (Upstash for
# Redis). Once connected to the project, Vercel injects these automatically —
# you normally don't set them by hand. Without them: the newsletter signup
# fails with "Constant Contact is not connected yet."
KV_REST_API_URL=
KV_REST_API_TOKEN=
